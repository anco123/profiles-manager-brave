// Snippet riêng cho dự án này -- gõ "pm" trong file .js là VS Code gợi ý.
// Tab để nhảy giữa các ô ${1}, ${2}...; $0 là chỗ con trỏ dừng cuối cùng.
// Thêm snippet mới: copy 1 khối bên dưới, đổi tên/prefix/body là xong (lưu file là có hiệu lực, không cần restart).
// Tên đặt dạng "Nhóm: mô tả" -- panel PM Snippets (thư mục vscode-snippets-panel/) gom theo phần trước dấu ":".
{
  // ---------- Khung chung ----------
  "Chung: tạo deps (helpers + ambientMouseMove)": {
    "scope": "javascript", "prefix": "pm-deps",
    "body": ["const helpers = require('./helpers'); const { ambientMouseMove } = require('./xlv3_interactXHome');", "const deps = { ...helpers, ambientMouseMove };"]
  },
  "Chung: đọc dòng Excel hiện tại (input)": {
    "scope": "javascript", "prefix": "pm-row",
    "body": ["const row = input ? JSON.parse(input) : {}; const currentExcelRow = row.__excelRow;", "const ${1:username} = row.${2:D};$0"]
  },
  "Chung: module xlv mới": {
    "scope": "javascript", "prefix": "pm-module",
    "body": ["async function ${1:${TM_FILENAME_BASE}}(page, log, deps${2:, arg}) {", "  log('[$1] bắt đầu');", "  $0", "}", "", "module.exports = { $1 };"]
  },
  "Chung: try/catch có log": {
    "scope": "javascript", "prefix": "pm-try",
    "body": ["try { $0 } catch (e) { log(`[${1:tag}] lỗi: \\${e.message}`); }"]
  },
  "Chung: delay ngẫu nhiên": {
    "scope": "javascript", "prefix": "pm-sleep",
    "body": ["await page.waitForTimeout(${1:1000} + Math.floor(Math.random() * ${2:2000}));$0"]
  },

  // ---------- xlv1 ----------
  "xlv1: đổi IP proxy": {
    "scope": "javascript", "prefix": "pm-changeProxy",
    "body": ["const { changeProxy } = require('./xlv1_changeProxy');", "await changeProxy(context, proxyInfo, log);$0"]
  },
  "xlv1: check X suspend": {
    "scope": "javascript", "prefix": "pm-getXStatus",
    "body": ["const { getXStatus } = require('./xlv1_getXStatus');", "const xStatus = await getXStatus(${1:username}, proxyInfo, log);$0"]
  },
  "xlv1: thông tin thiết bị": {
    "scope": "javascript", "prefix": "pm-deviceInfo",
    "body": ["const { getDeviceInfo } = require('./xlv1_getDeviceInfo');", "const deviceInfo = await getDeviceInfo(page, log);$0"]
  },
  "xlv1: đóng bớt tab thừa": {
    "scope": "javascript", "prefix": "pm-singleTab",
    "body": ["const { ensureSingleTab } = require('./xlv1_ensureSingleTab');", "await ensureSingleTab(context, log);$0"]
  },
  "xlv1: đọc ô Excel": {
    "scope": "javascript", "prefix": "pm-readExcel",
    "body": ["const { readExcelCell } = require('./xlv1_readExcelCell');", "const ${1:value} = readExcelCell(${2:currentExcelRow}, '${3:G}');$0"]
  },
  "xlv1: ghi ô Excel": {
    "scope": "javascript", "prefix": "pm-writeExcel",
    "body": ["const { writeExcelCell } = require('./writeExcelCell');", "await writeExcelCell(${1:currentExcelRow}, '${2:M}', ${3:'Done'});$0"]
  },
  "xlv1: xuất snapshot ra Excel": {
    "scope": "javascript", "prefix": "pm-exportExcel",
    "body": ["const { exportSnapshotToExcel } = require('./xlv1_exportSnapshotToExcel');", "await exportSnapshotToExcel();$0"]
  },
  "xlv1: đọc ô Google Sheet": {
    "scope": "javascript", "prefix": "pm-readGSheet",
    "body": ["const { readGoogleSheetCell } = require('./readGoogleSheetCell');", "const ${1:content} = readGoogleSheetCell(row, '${2:C}', '${3:REPLY}');$0"]
  },
  "xlv1: đánh dấu xoá-tạo-lại profile": {
    "scope": "javascript", "prefix": "pm-markRecreate",
    "body": ["const { markProfileForRecreate } = require('./xlv1_markProfileForRecreate');", "await markProfileForRecreate(proxyInfo.profileId, proxyInfo.profileName, currentExcelRow, log);$0"]
  },

  // ---------- xlv2 ----------
  "xlv2: vào trang cá nhân": {
    "scope": "javascript", "prefix": "pm-gotoProfile",
    "body": ["const { gotoProfile } = require('./xlv2_gotoProfile');", "await gotoProfile(page, log, deps, ${1:username});$0"]
  },
  "xlv2: check followers (ghi cột G)": {
    "scope": "javascript", "prefix": "pm-checkFollowers",
    "body": ["const { xlv2_checkFollowers } = require('./xlv2_checkFollowers');", "await xlv2_checkFollowers(page, log, deps, ${1:currentExcelRow});$0"]
  },

  "xlv2: chụp màn hình vùng element": {
    "scope": "javascript", "prefix": "pm-screenshot",
    "body": ["const { xlv2_getScreenShot } = require('./xlv2_getScreenShot');", "const shotFile = await xlv2_getScreenShot(page, log, [${1:'elA'}, ${2:'elB'}], row.__excelRow);$0"]
  },
  "xlv2: đính file (ảnh) vào ô comment/post": {
    "scope": "javascript", "prefix": "pm-attachFile",
    "body": ["const { xlv2_attachFile } = require('./xlv2_attachFile');", "const attached = await xlv2_attachFile(page, log, ${1:'input_image_element'}, ${2:shotFile}, { previewElement: ${3:null} });$0"]
  },

  // ---------- xlv3 ----------
  "xlv3: login X (cookie hoặc mật khẩu)": {
    "scope": "javascript", "prefix": "pm-loginX",
    "body": ["const loginResult = (row.I || '').toString().includes('Cookie')", "  ? await require('./xlv3_loginByCookie').loginByCookie(page, context, log, require, input)", "  : await require('./xlv3_loginX').loginToX(page, context, log, require, input);$0"]
  },
  "xlv3: tương tác X (interactX)": {
    "scope": "javascript", "prefix": "pm-interactX",
    "body": ["const { interactX } = require('./xlv3_Interactx');", "await interactX(page, context, log, require, input, ${1:soFollower});$0"]
  },
  "xlv3: lướt Home": {
    "scope": "javascript", "prefix": "pm-browseHome",
    "body": ["const { browseHomeVaried } = require('./xlv3_interactXHome');", "await browseHomeVaried(page, log, deps);$0"]
  },
  "xlv3: follow": {
    "scope": "javascript", "prefix": "pm-follow",
    "body": ["const { xlv3_follow_friends } = require('./xlv3_follow_friends');", "await xlv3_follow_friends(page, log, deps, ${1:targetUsername});$0"]
  },
  "xlv3: like tweet": {
    "scope": "javascript", "prefix": "pm-like",
    "body": ["const { xlv3_like_tweet } = require('./xlv3_like_tweet');", "await xlv3_like_tweet(page, log, deps, ${1:postUrl}, ${2:maxInlineAttempts}, ${3:maxIterations});$0"]
  },
  "xlv3: retweet": {
    "scope": "javascript", "prefix": "pm-retweet",
    "body": ["const { xlv3_retweet_targettw } = require('./xlv3_retweet_targettw');", "await xlv3_retweet_targettw(page, log, deps, ${1:postUrl}, ${2:maxInlineAttempts}, ${3:maxIterations});$0"]
  },
  "xlv3: reply tweet": {
    "scope": "javascript", "prefix": "pm-reply",
    "body": ["const { xlv3_reply_tweet } = require('./xlv3_reply_tweet');", "await xlv3_reply_tweet(page, log, deps, ${1:postUrl}, ${2:maxInlineAttempts}, ${3:maxIterations}, ${4:content}, input);$0"]
  },
  "xlv3: đăng tweet": {
    "scope": "javascript", "prefix": "pm-postTweet",
    "body": ["const { xlv3_postTweet } = require('./xlv3_postTweet');", "await xlv3_postTweet(page, log, deps, ${1:tweetContent});$0"]
  },
  "xlv3: login Phantom": {
    "scope": "javascript", "prefix": "pm-loginPhantom",
    "body": ["const { checkAndLoginPhantom } = require('./xlv3_loginPhantom');", "const phantomResult = await checkAndLoginPhantom(page, context, log, require, ${1:row.R});$0"]
  },
  "xlv3: bind + login Tesseract": {
    "scope": "javascript", "prefix": "pm-tesseract",
    "body": ["const { bindAndLoginToTesseract } = require('./xlv3_bindAndLoginToTesseract');", "await bindAndLoginToTesseract(page, context, log);$0"]
  }
}
