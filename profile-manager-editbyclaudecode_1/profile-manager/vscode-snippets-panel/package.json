{
  "name": "pm-snippets-panel",
  "displayName": "PM Snippets",
  "description": "Panel bên trái liệt kê snippet của profile-manager (.vscode/*.code-snippets) -- bấm là chèn tại con trỏ.",
  "version": "1.0.0",
  "publisher": "anco123",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:**/.vscode/*.code-snippets"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "pmSnippets", "title": "PM Snippets", "icon": "icon.svg" }] },
    "views": { "pmSnippets": [{ "id": "pmSnippets.list", "name": "Snippets" }] },
    "commands": [
      { "command": "pmSnippets.insert", "title": "Chèn snippet" },
      { "command": "pmSnippets.refresh", "title": "Tải lại", "icon": "$(refresh)" },
      { "command": "pmSnippets.openFile", "title": "Mở file snippet", "icon": "$(go-to-file)" },
      { "command": "pmSnippets.addFromSelection", "title": "PM: Lưu đoạn đang chọn thành snippet", "icon": "$(add)" },
      { "command": "pmSnippets.edit", "title": "Sửa", "icon": "$(edit)" }
    ],
    "menus": {
      "view/title": [
        { "command": "pmSnippets.addFromSelection", "when": "view == pmSnippets.list", "group": "navigation@1" },
        { "command": "pmSnippets.openFile", "when": "view == pmSnippets.list", "group": "navigation@2" },
        { "command": "pmSnippets.refresh", "when": "view == pmSnippets.list", "group": "navigation@3" }
      ],
      "view/item/context": [{ "command": "pmSnippets.edit", "when": "view == pmSnippets.list && viewItem == snippet", "group": "inline" }],
      "editor/context": [{ "command": "pmSnippets.addFromSelection", "when": "editorHasSelection", "group": "9_pm" }],
      "commandPalette": [{ "command": "pmSnippets.insert", "when": "false" }, { "command": "pmSnippets.edit", "when": "false" }]
    }
  }
}
